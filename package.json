    "framer-motion": "^12.43.0",
    "lenis": "^1.3.25",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.22.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
