# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real values.

# Supabase Data API (server-only, never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (server-only, never NEXT_PUBLIC_)
RESEND_API_KEY=

# Non-secret inquiry-notification email config (server-only; not secret, but
# environment-configured for safer deployment/testing across environments)
INQUIRY_NOTIFICATION_FROM=
INQUIRY_NOTIFICATION_TO=
INQUIRY_NOTIFICATION_REPLY_TO=

# Acknowledgment email sent to the client after a saved inquiry (server-only,
# not secret). Separate from the internal notification above. Both are needed
# for it to send; with either missing it is skipped and logged. Suggested
# values: From "Mintapp <hello@mail.mintapp.tech>", Reply-To hello@mintapp.tech.
# It also obeys EMAIL_SENDING_MODE below.
INQUIRY_ACK_FROM=
INQUIRY_ACK_REPLY_TO=

# Real-email fail-safe (server-only, not secret). A valid RESEND_API_KEY
# alone is NOT enough to send a real email — this must also be "send".
# Production requires this to be explicitly "send" or "disabled"; a missing
# or invalid value there produces a controlled configuration error and
# prevents notification delivery (evaluated per-request, not at startup).
# Everywhere else it defaults to "disabled" and only "send" opts in;
# automated tests/CI ignore this entirely and always force delivery off.
EMAIL_SENDING_MODE=disabled

# Cloudflare Turnstile — the site key is intentionally client-safe (it's
# inlined into the browser bundle via NEXT_PUBLIC_); the secret key is
# server-only, never NEXT_PUBLIC_. For local development, use Cloudflare's
# official published test keys, never real production keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com meeting scheduling. NEXT_PUBLIC_CAL_LINK is the public embed
# calLink (client-safe, inlined into the browser bundle). CAL_EVENT_TYPE_ID
# is the numeric event-type ID, server-only but not secret — validated
# against every webhook payload as defense-in-depth (the same account
# could have other event types later). CAL_WEBHOOK_SECRET and
# CAL_BOOKING_CONTEXT_SECRET are two independent server-only secrets —
# never the same value, so rotating one never invalidates the other.
NEXT_PUBLIC_CAL_LINK=
CAL_EVENT_TYPE_ID=
CAL_WEBHOOK_SECRET=
CAL_BOOKING_CONTEXT_SECRET=

# Meeting preparation (internal). Off unless PREPARATION_GENERATOR is set.
# off | mock | codecraft
PREPARATION_GENERATOR=
# Server-only secret for POST /api/internal/preparations/run (32+ chars).
PREPARATION_WORKER_SECRET=
# Monthly token cap enforced by the app (max 1000000; default 600000).
PREPARATION_MONTHLY_TOKEN_BUDGET=
PREPARATION_MAX_OUTPUT_TOKENS=
# CodeCraft API. Never commit a real key. Set CODECRAFT_MODEL to an exact id
# from: node --env-file=.env.local scripts/codecraft-models.mjs
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=
CODECRAFT_MODEL=
CODECRAFT_TIMEOUT_MS=
# Only "true" once the model's upstream provider and data terms are verified.
CODECRAFT_CLIENT_DATA_APPROVED=

# ---------------------------------------------------------------------------
# Private admin application: a SEPARATE Vercel project from the same
# repository. Leave all of these unset in the public site's project.
#
# Build the admin application (admin routes exist only in this build).
APP_SURFACE=
# Hostnames it answers on, comma-separated (the chosen admin subdomain).
# Production answers nowhere until this is set; Previews also answer on their
# own generated hostnames.
ADMIN_HOSTS=
# Sign-in: Supabase Auth with a required authenticator app (TOTP). Needs
# SUPABASE_URL above, the project's publishable (anon) key, and
# public sign-ups disabled in the Supabase project.
SUPABASE_PUBLISHABLE_KEY=
# The allowlist: JSON list of {email, name}. Only these accounts get in.
ADMIN_TEAM=
# 32+ random characters; signs the idle/absolute session-limit record.
ADMIN_SESSION_SECRET=

# The custom team login (TEAM_ACCOUNTS, DASHBOARD_SESSION_SECRET) exists only
# for the local synthetic demo (node scripts/dashboard-demo.mjs), which sets
# its own values. It cannot run in a production build; never set it on Vercel.
